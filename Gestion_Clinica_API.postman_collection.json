              "raw": "{{base_url}}/api/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token"
              ]
            }
          }
        },
        {
          "name": "Login Asistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('token', jsonData.access_token);",
                  "    console.log('Token Asistente guardado.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{assistant_email}}\",\n  \"password\": \"{{assistant_password}}\",\n  \"device_name\": \"postman-assistant\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token"
              ]
            }
          }
        },
        {
          "name": "Perfil del Usuario Autenticado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "",
                  "    if (jsonData && jsonData.id) {",
                  "        pm.environment.set('user_id', jsonData.id);",
                  "        console.log('user_id guardado: ' + jsonData.id);",
                  "    }",
                  "",
                  "    var doctorEmail = pm.environment.get('doctor_email');",
                  "    if (jsonData && jsonData.id && jsonData.email && doctorEmail && jsonData.email.toLowerCase() === doctorEmail.toLowerCase()) {",
                  "        pm.environment.set('doctor_id', jsonData.id);",
                  "        console.log('doctor_id guardado: ' + jsonData.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user"
              ]
            }
          }
        },
        {
          "name": "Logout - Revocar Token",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/token",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "token"
              ]
            }
          }
        }
      ]
